# ─────────────────────────────────────────────────────
# BASE DE DATOS — Supabase + Prisma
# Supabase → Settings → Database → Connection string
# ─────────────────────────────────────────────────────

# URL con connection pooling (PgBouncer, puerto 6543) — para queries en runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# URL directa (puerto 5432, sin pooler) — para migraciones Prisma
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────
# AUTH.JS v5
# Genera AUTH_SECRET con: openssl rand -base64 32
# ─────────────────────────────────────────────────────
AUTH_SECRET="genera-con-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth (opcional — configurar en console.cloud.google.com)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─────────────────────────────────────────────────────
# IA — Anthropic Claude (planes Pro, Growth, Premium)
# Obtener en console.anthropic.com → API Keys
# ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─────────────────────────────────────────────────────
# STRIPE
# Obtener en dashboard.stripe.com
# ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# IDs de precios en Stripe (crear productos manualmente o via script)
# Nombres técnicos (enum Plan):
STRIPE_PRICE_BASIC_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
# Aliases de marca (rebranding) — lib/billing/price-map.ts mapea ambos. Basta configurar un set.
# BASIC=Presencia · PRO=Growth (B2B) · GROWTH=Elite · PREMIUM=Partner
STRIPE_PRICE_PRESENCIA_MONTHLY=""
STRIPE_PRICE_B2B_GROWTH_MONTHLY=""
STRIPE_PRICE_ELITE_MONTHLY=""
STRIPE_PRICE_PARTNER_MONTHLY=""

# ─────────────────────────────────────────────────────
# EMAIL — Resend
# Obtener en resend.com → API Keys
# ─────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Belleza Local <noreply@bellezalocal.es>"

# ─────────────────────────────────────────────────────
# SMS (Twilio — add-on, opcional)
# ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─────────────────────────────────────────────────────
# WHATSAPP BUSINESS API (add-on, planes Growth+)
# Meta Business Manager → WhatsApp → API Setup
# ─────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ─────────────────────────────────────────────────────
# UPLOADS / STORAGE — Cloudflare R2
# Cloudflare Dashboard → R2 → Create bucket
# ─────────────────────────────────────────────────────
STORAGE_ENDPOINT="https://[account-id].r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="belleza-local-uploads"
NEXT_PUBLIC_CDN_URL="https://cdn.bellezalocal.es"

# ─────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Belleza Local"
NODE_ENV="development"

# Cron jobs (Vercel Cron — recordatorios, etc.)
CRON_SECRET="genera-con-openssl-rand-base64-32"

# ─────────────────────────────────────────────────────
# ANALYTICS (opcional)
# ─────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"
