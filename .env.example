# ─────────────────────────────────────────────────────
# BASE DE DATOS — Supabase + Prisma
# ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────
# AUTH.JS v5
# Genera secretos con: openssl rand -base64 32
# ─────────────────────────────────────────────────────
AUTH_SECRET="genera-con-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Belleza Local"
NODE_ENV="development"
CRON_SECRET="genera-con-openssl-rand-base64-32"

# ─────────────────────────────────────────────────────
# FEATURE FLAGS — módulos avanzados cerrados por defecto
# Activa únicamente después de smoke test y credenciales listas.
# ─────────────────────────────────────────────────────
FEATURE_MARKETPLACE="true"
FEATURE_PRODUCTS="false"
FEATURE_BONOS="false"
FEATURE_BEAUTY_CONCIERGE="false"
FEATURE_AI_RECOMMENDATIONS="false"
FEATURE_CAMPAIGNS="false"
FEATURE_FOLLOW_UPS="true"
FEATURE_WALLET="false"

# ─────────────────────────────────────────────────────
# RATE LIMITING DISTRIBUIDO — Upstash Redis
# Obligatorio en producción; el fallback en memoria es solo defensivo.
# ─────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─────────────────────────────────────────────────────
# STRIPE
# ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASIC_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
# Aliases de marca: BASIC=Presencia · PRO=Growth · GROWTH=Elite · PREMIUM=Partner
STRIPE_PRICE_PRESENCIA_MONTHLY=""
STRIPE_PRICE_B2B_GROWTH_MONTHLY=""
STRIPE_PRICE_ELITE_MONTHLY=""
STRIPE_PRICE_PARTNER_MONTHLY=""

# ─────────────────────────────────────────────────────
# EMAIL — Resend
# ─────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Belleza Local <noreply@bellezalocal.es>"

# ─────────────────────────────────────────────────────
# UPLOADS — Cloudflare R2
# ─────────────────────────────────────────────────────
STORAGE_ENDPOINT="https://[account-id].r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="belleza-local-uploads"
NEXT_PUBLIC_CDN_URL="https://cdn.bellezalocal.es"

# ─────────────────────────────────────────────────────
# IA — solo si FEATURE_AI_RECOMMENDATIONS=true
# ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─────────────────────────────────────────────────────
# INTEGRACIONES OPCIONALES
# ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"

# Webhook privado para alertas operativas; nunca debe apuntar a un canal público.
OBSERVABILITY_WEBHOOK_URL=""

# n8n: utilizar las variables exactas ya consumidas por lib/integrations/n8n.ts.
N8N_LEAD_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""
