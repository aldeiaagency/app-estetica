generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooled (PgBouncer) — para queries
  directUrl = env("DIRECT_URL") // Supabase direct — para migraciones
}

// ─────────────────────────────────────────────────────
// AUTH (Auth.js v5 adapter)
// ─────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(CUSTOMER)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  accounts      Account[]
  sessions      Session[]
  beautyProfile BeautyProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────
// BEAUTY CONCIERGE - PERFIL Y OBJETIVOS
// ─────────────────────────────────────────────────────

model BeautyProfile {
  id     String @id @default(cuid())
  userId String @unique

  skinType           SkinType?
  hairType           HairType?
  beautyStyle        BeautyStyle?
  monthlyBudgetCents Int?
  maintenanceLevel   MaintenanceLevel?

  mainConcern      String?
  secondaryConcern String?
  priceSensitivity PriceSensitivity?
  buyingMotivation BuyingMotivation?
  fear             BeautyFear?

  consentPersonalizationAt DateTime?
  profileCompletedAt       DateTime?

  goals         BeautyGoal[]
  plans         BeautyPlan[]
  benefits      UserBenefit[]
  routines      BeautyRoutine[]
  productUsages ProductUsage[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BeautyGoal {
  id        String @id @default(cuid())
  profileId String

  area      BeautyArea
  objective String
  priority  Int        @default(0)
  active    Boolean    @default(true)

  createdAt DateTime @default(now())

  profile BeautyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, active])
}

model BeautyPlan {
  id        String @id @default(cuid())
  profileId String

  title                String
  month                String
  summary              String?
  status               BeautyPlanStatus @default(ACTIVE)
  estimatedBudgetCents Int?

  items BeautyPlanItem[]

  profile BeautyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, month])
}

model BeautyPlanItem {
  id     String @id @default(cuid())
  planId String

  type     BeautyPlanItemType
  title    String
  reason   String?
  priority Int                @default(0)

  serviceId String?
  productId String?
  packId    String?
  centerId  String?

  recommendedDate     DateTime?
  estimatedPriceCents Int?
  status              BeautyPlanItemStatus @default(PENDING)

  plan BeautyPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  pack BeautyPack? @relation(fields: [packId], references: [id])

  @@index([planId])
  @@index([status])
}

model BeautyBenefit {
  id       String  @id @default(cuid())
  centerId String?

  title       String
  description String?
  benefitType BeautyBenefitType
  value       String?
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean           @default(true)

  minPlanRequired Plan?
  membersOnly     Boolean @default(false)

  center       Center?       @relation(fields: [centerId], references: [id])
  userBenefits UserBenefit[]

  createdAt DateTime @default(now())

  @@index([centerId, active])
  @@index([active])
}

model UserBenefit {
  id        String @id @default(cuid())
  profileId String
  benefitId String

  status    UserBenefitStatus @default(ACTIVE)
  claimedAt DateTime?
  usedAt    DateTime?

  profile BeautyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  benefit BeautyBenefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@unique([profileId, benefitId])
  @@index([profileId, status])
}

// ─────────────────────────────────────────────────────
// ORGANIZACIÓN Y CENTROS
// ─────────────────────────────────────────────────────

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  plan                 Plan      @default(BASIC)
  planExpiresAt        DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  maxCenters           Int       @default(1)

  users   User[]
  centers Center[]
  addOns  OrganizationAddOn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Center {
  id              String  @id @default(cuid())
  organizationId  String
  name            String
  slug            String  @unique
  description     String?
  descriptionLong String?

  category CenterCategory
  phone    String?
  whatsapp String?
  email    String?
  website  String?

  addressStreet     String   @default("")
  addressCity       String
  addressProvince   String
  addressPostalCode String   @default("")
  addressLat        Decimal? @db.Decimal(9, 6)
  addressLng        Decimal? @db.Decimal(9, 6)

  coverImage    String?
  galleryImages String[] @default([])

  published  Boolean   @default(false)
  approvedAt DateTime?
  approvedBy String?
  seoNoindex Boolean   @default(false)

  organization      Organization        @relation(fields: [organizationId], references: [id])
  services          Service[]
  staff             Staff[]
  resources         Resource[]
  bookings          Booking[]
  customers         Customer[]
  scheduleRules     ScheduleRule[]
  exceptions        ScheduleException[]
  manualBlocks      ManualBlock[]
  bonos             Bono[]
  products          Product[]
  orders            Order[]
  promotions        Promotion[]
  reviews           Review[]
  featuredListings  FeaturedListing[]
  waitlistEntries   WaitlistEntry[]
  beautyBenefits    BeautyBenefit[]
  beautyPacks       BeautyPack[]
  followUpTemplates FollowUpTemplate[]
  followUpMessages  FollowUpMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([addressCity, category])
  @@index([published])
}

// ─────────────────────────────────────────────────────
// CATEGORÍAS Y SERVICIOS
// ─────────────────────────────────────────────────────

model ServiceCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  icon        String?
  order       Int     @default(0)

  services Service[]
}

model Service {
  id         String  @id @default(cuid())
  centerId   String
  categoryId String?

  name                String
  description         String?
  durationMinutes     Int
  priceCents          Int
  depositRequired     Boolean @default(false)
  depositCents        Int?
  bufferMinutesBefore Int     @default(0)
  bufferMinutesAfter  Int     @default(10)
  maxCapacity         Int     @default(1)
  active              Boolean @default(true)
  order               Int     @default(0)

  center   Center           @relation(fields: [centerId], references: [id])
  category ServiceCategory? @relation(fields: [categoryId], references: [id])

  serviceStaff ServiceStaff[]
  bookings     Booking[]
  bonos        Bono[]
  promotions   Promotion[]

  createdAt DateTime @default(now())

  @@index([centerId])
}

model ServiceStaff {
  serviceId String
  staffId   String

  service Service @relation(fields: [serviceId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])

  @@id([serviceId, staffId])
}

// ─────────────────────────────────────────────────────
// STAFF Y RECURSOS
// ─────────────────────────────────────────────────────

model Staff {
  id       String @id @default(cuid())
  centerId String

  name   String
  role   String?
  bio    String?
  image  String?
  active Boolean @default(true)
  order  Int     @default(0)

  center        Center              @relation(fields: [centerId], references: [id])
  bookings      Booking[]
  serviceStaff  ServiceStaff[]
  scheduleRules ScheduleRule[]
  exceptions    ScheduleException[]
  manualBlocks  ManualBlock[]

  createdAt DateTime @default(now())

  @@index([centerId])
}

model Resource {
  id       String @id @default(cuid())
  centerId String

  name     String
  type     String?
  capacity Int     @default(1)
  active   Boolean @default(true)

  center   Center    @relation(fields: [centerId], references: [id])
  bookings Booking[]

  @@index([centerId])
}

// ─────────────────────────────────────────────────────
// HORARIOS
// ─────────────────────────────────────────────────────

model ScheduleRule {
  id       String  @id @default(cuid())
  centerId String?
  staffId  String?

  dayOfWeek Int
  openTime  String
  closeTime String
  active    Boolean @default(true)

  center Center? @relation(fields: [centerId], references: [id])
  staff  Staff?  @relation(fields: [staffId], references: [id])

  @@index([centerId, dayOfWeek])
  @@index([staffId, dayOfWeek])
}

model ScheduleException {
  id       String  @id @default(cuid())
  centerId String?
  staffId  String?

  date      DateTime
  isClosed  Boolean  @default(false)
  openTime  String?
  closeTime String?
  reason    String?

  center Center? @relation(fields: [centerId], references: [id])
  staff  Staff?  @relation(fields: [staffId], references: [id])

  @@index([centerId, date])
  @@index([staffId, date])
}

model ManualBlock {
  id       String  @id @default(cuid())
  centerId String
  staffId  String?

  startAt DateTime
  endAt   DateTime
  reason  String?

  center Center @relation(fields: [centerId], references: [id])
  staff  Staff? @relation(fields: [staffId], references: [id])

  @@index([centerId, startAt, endAt])
}

// ─────────────────────────────────────────────────────
// CLIENTES Y RESERVAS
// ─────────────────────────────────────────────────────

model Customer {
  id       String  @id @default(cuid())
  userId   String?
  centerId String

  name                 String
  email                String
  phone                String?
  noShowCount          Int       @default(0)
  marketingConsent     Boolean   @default(false)
  marketingConsentDate DateTime?
  consentGivenAt       DateTime  @default(now())

  center           Center            @relation(fields: [centerId], references: [id])
  bookings         Booking[]
  bonoInstances    BonoInstance[]
  waitlistEntries  WaitlistEntry[]
  reviews          Review[]
  followUpMessages FollowUpMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, centerId])
  @@index([centerId])
}

model Booking {
  id               String @id @default(cuid())
  confirmationCode String @unique

  centerId   String
  serviceId  String
  staffId    String?
  resourceId String?
  customerId String

  startAt DateTime
  endAt   DateTime
  status  BookingStatus @default(PENDING)
  source  BookingSource @default(WEB)

  depositCents          Int?
  depositPaid           Boolean   @default(false)
  depositExpiresAt      DateTime?
  stripePaymentIntentId String?

  notes              String?
  internalNotes      String?
  reminderSentAt     DateTime?
  noShowAt           DateTime?
  cancelledAt        DateTime?
  cancelledBy        CancelledBy?
  cancellationReason String?

  center           Center            @relation(fields: [centerId], references: [id])
  service          Service           @relation(fields: [serviceId], references: [id])
  staff            Staff?            @relation(fields: [staffId], references: [id])
  resource         Resource?         @relation(fields: [resourceId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  review           Review?
  followUpMessages FollowUpMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([centerId, startAt, endAt])
  @@index([centerId, status])
  @@index([customerId])
  @@index([staffId, startAt, endAt])
  @@index([status, depositExpiresAt])
}

model WaitlistEntry {
  id         String  @id @default(cuid())
  centerId   String
  serviceId  String
  staffId    String?
  customerId String

  requestedDate DateTime
  notifiedAt    DateTime?
  status        WaitlistStatus @default(WAITING)

  center   Center   @relation(fields: [centerId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())

  @@index([centerId, status])
}

// ─────────────────────────────────────────────────────
// SEGUIMIENTO Y RECURRENCIA B2B
// ─────────────────────────────────────────────────────

model FollowUpTemplate {
  id       String @id @default(cuid())
  centerId String

  name            String
  category        FollowUpTemplateCategory @default(GENERIC)
  purpose         CommunicationPurpose     @default(FOLLOW_UP)
  channel         CommunicationChannel     @default(EMAIL)
  serviceKeyword  String?
  subject         String
  body            String
  sendAfterDays   Int                      @default(14)
  consentRequired Boolean                  @default(false)
  active          Boolean                  @default(true)

  center   Center            @relation(fields: [centerId], references: [id], onDelete: Cascade)
  messages FollowUpMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([centerId, active])
  @@index([category, active])
}

model FollowUpMessage {
  id         String  @id @default(cuid())
  centerId   String
  customerId String
  bookingId  String?
  templateId String?

  channel CommunicationChannel
  purpose CommunicationPurpose
  status  FollowUpMessageStatus @default(SCHEDULED)

  subject      String
  body         String
  scheduledFor DateTime
  sentAt       DateTime?
  dismissedAt  DateTime?

  center   Center            @relation(fields: [centerId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  template FollowUpTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, templateId])
  @@index([centerId, status, scheduledFor])
  @@index([customerId, status])
  @@index([purpose, status])
}

// COMERCIO (plan Pro)
model Bono {
  id       String @id @default(cuid())
  centerId String

  name         String
  description  String?
  sessions     Int
  validityDays Int
  priceCents   Int
  serviceId    String?
  active       Boolean @default(true)

  center      Center         @relation(fields: [centerId], references: [id])
  service     Service?       @relation(fields: [serviceId], references: [id])
  instances   BonoInstance[]
  beautyPacks BeautyPack[]

  createdAt DateTime @default(now())

  @@index([centerId])
}

model BeautyPack {
  id       String  @id @default(cuid())
  centerId String
  bonoId   String?

  name                String
  slug                String?
  objective           String
  description         String?
  audience            String?
  notFor              String?
  expectedResult      String?
  priceCents          Int
  compareAtPriceCents Int?
  durationDays        Int?
  preferredArea       BeautyArea?
  minMaintenanceLevel MaintenanceLevel?
  active              Boolean           @default(true)
  featured            Boolean           @default(false)

  center    Center           @relation(fields: [centerId], references: [id])
  bono      Bono?            @relation(fields: [bonoId], references: [id], onDelete: SetNull)
  items     BeautyPackItem[]
  planItems BeautyPlanItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([centerId, slug])
  @@index([centerId, active])
  @@index([preferredArea, active])
}

model BeautyPackItem {
  id     String @id @default(cuid())
  packId String

  label     String
  itemType  BeautyPackItemType @default(SERVICE)
  quantity  Int                @default(1)
  serviceId String?
  productId String?
  note      String?
  order     Int                @default(0)

  pack BeautyPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([packId])
}

model BonoInstance {
  id         String @id @default(cuid())
  bonoId     String
  customerId String
  centerId   String

  sessionsRemaining Int
  purchasedAt       DateTime  @default(now())
  activatedAt       DateTime?
  expiresAt         DateTime?
  stripePaymentId   String?

  bono     Bono     @relation(fields: [bonoId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([centerId])
}

// Categoría de producto global (espejo de ServiceCategory), con jerarquía opcional.
model BeautyRoutine {
  id        String @id @default(cuid())
  profileId String

  title  String
  status BeautyRoutineStatus @default(ACTIVE)

  profile BeautyProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  steps   BeautyRoutineStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, status])
}

model BeautyRoutineStep {
  id        String  @id @default(cuid())
  routineId String
  productId String?

  title        String
  stepType     BeautyRoutineStepType   @default(OTHER)
  moment       BeautyRoutineMoment     @default(AS_NEEDED)
  instructions String?
  order        Int                     @default(0)
  status       BeautyRoutineStepStatus @default(ACTIVE)
  pausedAt     DateTime?
  finishedAt   DateTime?

  routine BeautyRoutine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  product Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  usages  ProductUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([routineId, status])
  @@index([productId])
}

model ProductUsage {
  id        String  @id @default(cuid())
  profileId String
  productId String
  stepId    String?

  status                    ProductUsageStatus @default(IN_USE)
  startedAt                 DateTime           @default(now())
  expectedEndAt             DateTime?
  finishedAt                DateTime?
  pausedAt                  DateTime?
  replenishmentEnabled      Boolean            @default(false)
  replenishmentIntervalDays Int?
  lastReminderAt            DateTime?

  profile BeautyProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  product Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  step    BeautyRoutineStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, status])
  @@index([productId])
  @@index([expectedEndAt, replenishmentEnabled])
}

model ProductCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  icon        String?
  order       Int     @default(0)

  parentId String?
  parent   ProductCategory?  @relation("ProductCategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("ProductCategoryHierarchy")

  products Product[]

  @@index([parentId])
}

model Product {
  id         String  @id @default(cuid())
  centerId   String
  categoryId String?

  name        String
  slug        String?
  description String?
  brand       String?
  priceCents  Int
  stock       Int?
  image       String?
  images      String[] @default([])
  active      Boolean  @default(true)

  usageInstructions         String?
  recommendedFor            String?
  notRecommendedFor         String?
  expectedDurationDays      Int?
  replenishmentIntervalDays Int?
  routineStepType           BeautyRoutineStepType?
  compatibilityTags         String[]               @default([])
  recommendationTags        String[]               @default([])
  alternativeProductId      String?

  center             Center              @relation(fields: [centerId], references: [id])
  category           ProductCategory?    @relation(fields: [categoryId], references: [id])
  orderItems         OrderItem[]
  routineSteps       BeautyRoutineStep[]
  productUsages      ProductUsage[]
  alternativeProduct Product?            @relation("ProductAlternative", fields: [alternativeProductId], references: [id], onDelete: SetNull)
  alternativeFor     Product[]           @relation("ProductAlternative")

  createdAt DateTime @default(now())

  @@unique([centerId, slug])
  @@index([centerId])
  @@index([categoryId])
  @@index([brand])
  @@index([routineStepType, active])
}

model Order {
  id       String @id @default(cuid())
  centerId String

  customerName  String
  customerEmail String
  customerPhone String?

  totalCents Int
  status     OrderStatus @default(PENDING)
  notes      String?

  stripePaymentIntentId String?
  paidAt                DateTime?

  center Center      @relation(fields: [centerId], references: [id])
  items  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([centerId, status])
  @@index([customerEmail])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  name       String
  priceCents Int
  quantity   Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Promotion {
  id       String @id @default(cuid())
  centerId String

  title         String
  description   String?
  discountType  DiscountType
  discountValue Int
  serviceId     String?
  startsAt      DateTime
  endsAt        DateTime
  active        Boolean      @default(true)

  center  Center   @relation(fields: [centerId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  createdAt DateTime @default(now())

  @@index([centerId, active])
}

// ─────────────────────────────────────────────────────
// RESEÑAS (plan Pro)
// ─────────────────────────────────────────────────────

model Review {
  id         String @id @default(cuid())
  centerId   String
  bookingId  String @unique
  customerId String

  rating      Int
  comment     String?
  publishedAt DateTime?
  approved    Boolean   @default(false)
  moderatedBy String?
  reply       String?
  repliedAt   DateTime?

  center   Center   @relation(fields: [centerId], references: [id])
  booking  Booking  @relation(fields: [bookingId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())

  @@index([centerId, approved])
}

// ─────────────────────────────────────────────────────
// BILLING Y PLANES
// ─────────────────────────────────────────────────────

model OrganizationAddOn {
  id             String  @id @default(cuid())
  organizationId String
  centerId       String?

  addOnType                AddOnType
  activeFrom               DateTime
  activeTo                 DateTime?
  stripeSubscriptionItemId String?
  active                   Boolean   @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, active])
}

// ─────────────────────────────────────────────────────
// SEO Y MARKETPLACE
// ─────────────────────────────────────────────────────

model FeaturedListing {
  id       String @id @default(cuid())
  centerId String

  city     String
  category CenterCategory?
  service  String?
  priority Int             @default(0)
  startsAt DateTime
  endsAt   DateTime
  active   Boolean         @default(true)

  center Center @relation(fields: [centerId], references: [id])

  @@index([city, category, active])
}

// ─────────────────────────────────────────────────────
// AUDITORÍA
// ─────────────────────────────────────────────────────

model AdminAuditLog {
  id      String @id @default(cuid())
  actorId String

  action     String
  targetType String
  targetId   String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
}

// ─────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  BUSINESS
  BUSINESS_ADMIN
  PLATFORM_ADMIN
}

enum Plan {
  BASIC
  PRO
  GROWTH
  PREMIUM
}

enum CenterCategory {
  PELUQUERIA
  ESTETICA
  UNAS
  CEJAS_PESTANAS
  DEPILACION
  MASAJES
  SPA
  COSMETICA
  BELLEZA_INTEGRAL
  OTRO
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  WEB
  MARKETPLACE
  DASHBOARD
  API
}

enum CancelledBy {
  CUSTOMER
  BUSINESS
  SYSTEM
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
