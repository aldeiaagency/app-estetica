// Propuesta para .claude/settings.json (NO aplicada).
// Reduce prompts en operaciones de solo lectura/verificación y bloquea lo irreversible.
{
  "permissions": {
    "allow": [
      "Bash(npx prisma migrate status)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma generate)",
      "Bash(npm run type-check)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx prisma db push:*)",
      "Bash(vercel --prod:*)",
      "Bash(git push:*)"
    ]
  }
}
